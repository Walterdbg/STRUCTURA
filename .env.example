# Copy to .env and fill in. .env is never committed.

# Database password (any long random text).
DB_PASSWORD=change-me

# cloud = online engine; local = onsite engine (Linux box).
ENGINE_MODE=cloud

# Unique name for this installation, e.g. cloud-main or onsite-box-01.
DEPLOYMENT_ID=cloud-dev

# 127.0.0.1 = this computer only. On the onsite box use 0.0.0.0 so
# phones and tablets on the event network can reach it.
BIND_ADDRESS=127.0.0.1
PORT=8080

# Where nightly database backups are written.
BACKUP_DIR=./backups

# Place search for the Event map: none (off, map still works by clicking)
# or nominatim (OpenStreetMap public service; only the search words leave).
GEOCODER=none
