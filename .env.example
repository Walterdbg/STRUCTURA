# Copy to .env and fill in. .env is never committed.

# Database password (any long random text).
DB_PASSWORD=change-me

# cloud = online engine; local = onsite engine (Linux box).
ENGINE_MODE=cloud

# Unique name for this installation, e.g. cloud-main or onsite-box-01.
DEPLOYMENT_ID=cloud-dev

# 127.0.0.1 = this computer only. On the onsite box use 0.0.0.0 so
# phones and tablets on the event network can reach it.
BIND_ADDRESS=127.0.0.1
PORT=8080

# Where nightly database backups are written.
BACKUP_DIR=./backups

# Place search for the Event map (DEC-025): nominatim = OpenStreetMap's
# public search, used while testing (only the typed words leave, through our
# server). none = off. Before real customers: our own copy (option B).
GEOCODER=nominatim

# Google Maps Platform key (DEC-026): Google map pictures (streets + satellite),
# place search, street routing and elevation. Enable Places API (New), Map Tiles API,
# Routes API and Elevation API on the key. Empty = OpenStreetMap fallback.
GOOGLE_MAPS_KEY=

# ArcGIS Location Platform key (B-005): ArcGIS Topo, Streets and Imagery map pictures
# (US imagery is often leaf-off). Free account at location.arcgis.com; the key needs the
# Static Basemap Tiles privilege. Server-side only. Empty = these layers are hidden.
ARCGIS_KEY=
